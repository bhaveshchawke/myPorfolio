<%- include('./partials/head', {title: 'Dev Door Verification' }) %>

<body class="bg-[#f0f2f5] text-[#333] font-sans flex flex-col min-h-screen">
    <%- include("./partials/navBar") %>

    <main class="flex-grow flex justify-center items-center py-20 px-[5%] mt-16 max-[768px]:px-[15px] max-[768px]:py-[60px] max-[768px]:mt-[60px]">
        <div class="form-wrapper admin-profile-card bg-white max-w-[850px] w-full p-10 rounded-2xl shadow-[0_15px_35px_rgba(0,0,0,0.06)] border border-[#e0e0e0] max-[768px]:p-6">
            <form method="post" class="modern-form flex flex-col gap-5" id="adminFormId" enctype="multipart/form-data">
                
                <div class="form-header text-center mb-[35px] pb-5 border-b border-[#eee]">
                    <h2 class="text-[2rem] text-[#111] font-extrabold m-0 mb-2.5 tracking-[-0.5px] max-[480px]:text-[1.6rem]">Admin Profile Setup</h2>
                    <p class="text-[#666] text-[0.95rem] m-0">Enter your complete details for verification and portfolio generation.</p>
                </div>

                <% if (admin && admin.isAdmin) { %>
                    <!-- Logged In View -->
                    <div class="text-center py-[30px] px-2.5">
                        <i class="fa-solid fa-circle-check text-[3rem] text-[#4caf50] mb-[15px]"></i>
                        <h3 class="text-[#333] mb-2.5 text-[1.2rem] font-bold">Welcome Back, Admin!</h3>
                        <p class="text-[#666] mb-[25px]">You are already verified and logged in. What would you like to do?</p>
                        
                        <div class="flex gap-[15px] justify-center flex-wrap">
                            <a href="/admin/logout" class="bg-[#dc2626] text-white p-2.5 px-[25px] rounded-lg text-base font-bold cursor-pointer transition-all duration-300 flex justify-center items-center gap-2.5 hover:bg-[#b91c1c] hover:-translate-y-[2px] shadow-[0_4px_10px_rgba(220,38,38,0.2)] no-underline inline-flex">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </a>
                            <button type="button" class="bg-[#ff9800] text-white p-2.5 px-[25px] rounded-lg text-base font-bold cursor-pointer transition-all duration-300 flex justify-center items-center gap-2.5 hover:bg-[#e68a00] hover:-translate-y-[2px] shadow-[0_4px_10px_rgba(255,152,0,0.2)]" onclick="document.getElementById('editProfileContainer').style.display='block'; this.style.display='none';">
                                <i class="fa-solid fa-user-pen"></i> Edit Profile
                            </button>
                        </div>
                    </div>

                    <!-- Hidden Edit Form Container -->
                    <div id="editProfileContainer" style="display: none; margin-top: 30px; border-top: 2px dashed #eee; padding-top: 30px;">
                <% } %>

                <!-- =====================================
                     SECTION 1: ACCOUNT DETAILS
                     ===================================== -->
                <h3 class="section-subheading text-[1.2rem] text-[#333] mb-[15px] mt-[10px] pb-2.5 border-b border-[#f0f0f0] font-bold flex items-center gap-2.5"><i class="fa-solid fa-user text-[#ff9800]"></i> Account Details</h3>
                
                <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="fullName" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Full Name</label>
                        <input type="text" id="fullName" name="fullName" placeholder="e.g. Bhavesh Chawke" value="<%= adminDB ? adminDB.fullName : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                </div>

                <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="password" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Set Password</label>
                        <input type="password" id="password" name="password" placeholder="Min. 8 characters" minlength="8" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="confirmPassword" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" minlength="8" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                </div>

                <hr class="form-divider border-none border-t border-dashed border-[#ddd] my-6">

                <!-- =====================================
                     SECTION 2: PROFESSIONAL PROFILE
                     ===================================== -->
                <h3 class="section-subheading text-[1.2rem] text-[#333] mb-[15px] mt-[10px] pb-2.5 border-b border-[#f0f0f0] font-bold flex items-center gap-2.5"><i class="fa-solid fa-briefcase text-[#ff9800]"></i> Professional Profile</h3>

                <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="role" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Professional Role</label>
                        <input type="text" id="role" name="role" placeholder="e.g. MERN Stack Developer" value="<%= adminDB ? adminDB.role : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="bio" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Short Bio (Tagline)</label>
                        <input type="text" id="bio" name="bio" placeholder="e.g. Building digital experiences" value="<%= adminDB ? adminDB.bio : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                </div>

                <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="linkedinUrl" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">LinkedIn URL</label>
                        <input type="url" id="linkedinUrl" name="linkedinUrl" placeholder="https://linkedin.com/in/..." value="<%= adminDB ? adminDB.linkedinUrl : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="githubUrl" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">GitHub URL</label>
                        <input type="url" id="githubUrl" name="githubUrl" placeholder="https://github.com/..." value="<%= adminDB ? adminDB.githubUrl : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                    </div>
                </div>

                <div class="input-group flex flex-col gap-2 mb-2.5">
                    <label for="aboutMe" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">About Me (Detailed)</label>
                    <textarea id="aboutMe" name="aboutMe" rows="3" placeholder="Write a brief description about your journey, skills, and goals..." required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]"><%= adminDB ? adminDB.aboutMe : '' %></textarea>
                </div>

                <hr class="form-divider border-none border-t border-dashed border-[#ddd] my-6">

                <!-- =====================================
                     SECTION 3: UPLOAD FILES
                     ===================================== -->
                <h3 class="section-subheading text-[1.2rem] text-[#333] mb-[15px] mt-[10px] pb-2.5 border-b border-[#f0f0f0] font-bold flex items-center gap-2.5"><i class="fa-solid fa-cloud-arrow-up text-[#ff9800]"></i> Upload Files</h3>

                <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="profilePic" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Profile Picture</label>
                        <div class="file-upload-area border-2 border-dashed border-[#ccc] rounded-xl p-[25px] text-center cursor-pointer bg-[#fafafa] transition-all duration-300 relative overflow-hidden group hover:border-[#ff9800] hover:bg-[#fff3e0]" id="profilePicArea">
                            <input type="file" id="profilePic" name="profilePic" accept="image/*" class="file-input-hidden absolute top-0 left-0 w-full h-full opacity-0 cursor-pointer z-10">
                            <div class="file-upload-content pointer-events-none">
                                <i class="fa-solid fa-image file-upload-icon text-[2.5rem] text-[#999] mb-2.5 transition-colors duration-300 group-hover:text-[#ff9800]"></i>
                                <p class="file-upload-text font-bold text-[#444] m-0 mb-1">Click to upload image</p>
                                <span class="file-upload-hint text-[0.8rem] text-[#888]">JPG, PNG, WEBP (Max 5MB)</span>
                            </div>
                        </div>
                        <!-- Preview for selected file -->
                        <div class="file-preview mt-2.5 relative inline-block max-w-[120px] rounded-lg overflow-hidden border border-[#eee]" id="profilePicPreview" style="display: none;">
                            <img id="profilePicPreviewImg" src="" alt="Preview" class="w-full h-auto block">
                            <button type="button" class="file-preview-remove absolute top-1 right-1 w-[22px] h-[22px] bg-black/60 text-white border-none rounded-full flex items-center justify-center text-[10px] cursor-pointer hover:bg-[#dc2626]" id="removeProfilePicPreview" title="Remove">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                        <!-- Existing file from DB -->
                        <% if (adminDB && adminDB.profilePicUrl) { %>
                        <div class="file-existing mt-2.5 p-3.5 bg-[#f9f9f9] border border-[#eee] rounded-lg flex items-center gap-3.5" id="existingProfilePic">
                            <img src="<%= adminDB.profilePicUrl %>" alt="Current Profile Pic" class="existing-thumb w-10 h-10 object-cover rounded-md border border-[#ddd]">
                            <div class="existing-info flex-1 flex justify-between items-center max-[480px]:flex-col max-[480px]:items-start max-[480px]:gap-2.5">
                                <span class="text-[0.85rem] font-bold text-[#555]">Current Profile Pic</span>
                                <button type="button" class="btn-delete-file bg-transparent border-none text-[#dc2626] text-[0.85rem] cursor-pointer flex items-center gap-[5px] font-bold hover:underline" id="deleteProfilePicBtn" title="Delete from Cloudinary">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                        <label for="resume" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Resume / CV</label>
                        <div class="file-upload-area border-2 border-dashed border-[#ccc] rounded-xl p-[25px] text-center cursor-pointer bg-[#fafafa] transition-all duration-300 relative overflow-hidden group hover:border-[#ff9800] hover:bg-[#fff3e0]" id="resumeArea">
                            <input type="file" id="resume" name="resume" accept=".pdf" class="file-input-hidden absolute top-0 left-0 w-full h-full opacity-0 cursor-pointer z-10">
                            <div class="file-upload-content pointer-events-none">
                                <i class="fa-solid fa-file-pdf file-upload-icon text-[2.5rem] text-[#999] mb-2.5 transition-colors duration-300 group-hover:text-[#ff9800]"></i>
                                <p class="file-upload-text font-bold text-[#444] m-0 mb-1">Click to upload PDF</p>
                                <span class="file-upload-hint text-[0.8rem] text-[#888]">PDF only (Max 5MB)</span>
                            </div>
                        </div>
                        <!-- Preview for selected file -->
                        <div class="file-preview file-preview-doc mt-2.5 p-3.5 bg-[#e3f2fd] border border-[#bbdefb] rounded-lg flex items-center gap-2.5 relative" id="resumePreview" style="display: none;">
                            <i class="fa-solid fa-file-pdf file-preview-doc-icon text-[#1976d2] text-[1.2rem]"></i>
                            <span id="resumeFileName" class="text-[0.85rem] text-[#1565c0] font-bold truncate pr-[25px]"></span>
                            <button type="button" class="file-preview-remove absolute top-1/2 -translate-y-1/2 right-[10px] w-[22px] h-[22px] bg-black/60 text-white border-none rounded-full flex items-center justify-center text-[10px] cursor-pointer hover:bg-[#dc2626]" id="removeResumePreview" title="Remove">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                        <!-- Existing file from DB -->
                        <% if (adminDB && adminDB.resumeUrl) { %>
                        <div class="file-existing mt-2.5 p-3.5 bg-[#f9f9f9] border border-[#eee] rounded-lg flex items-center gap-3.5" id="existingResume">
                            <i class="fa-solid fa-file-pdf existing-doc-icon text-[1.5rem] text-[#e74c3c]"></i>
                            <div class="existing-info flex-1 flex justify-between items-center flex-wrap gap-2.5">
                                <span class="text-[0.85rem] font-bold text-[#555] w-full block">Current Resume</span>
                                <div class="flex gap-2.5">
                                    <a href="<%= adminDB.resumeUrl %>" target="_blank" class="btn-view-file bg-[#e3f2fd] text-[#1976d2] py-1 px-2.5 rounded text-[0.8rem] font-bold no-underline flex items-center gap-[5px] transition-colors hover:bg-[#1976d2] hover:text-white" title="View Resume">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    <button type="button" class="btn-delete-file bg-transparent border-none text-[#dc2626] text-[0.85rem] cursor-pointer flex items-center gap-[5px] font-bold hover:underline" id="deleteResumeBtn" title="Delete from Cloudinary">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <hr class="form-divider border-none border-t border-dashed border-[#ddd] my-6">

                <!-- =====================================
                     SECTION 4: VERIFICATION
                     ===================================== -->
                <div class="verification-section">
                    <h3 class="section-subheading text-[1.2rem] text-[#333] mb-[15px] mt-[10px] pb-2.5 border-b border-[#f0f0f0] font-bold flex items-center gap-2.5"><i class="fa-solid fa-shield-halved text-[#ff9800]"></i> Contact & Verification</h3>
                    
                    <div class="input-row flex gap-[25px] max-[768px]:flex-col max-[768px]:gap-5">
                        <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                            <label for="phone" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Phone Number</label>
                            <input type="tel" id="phone" name="phone" placeholder="e.g. +91 9876543210" value="<%= adminDB ? adminDB.phone : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)]">
                        </div>
                        <div class="input-group flex-1 flex flex-col gap-2 mb-2.5">
                            <label for="email" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Email Address</label>
                            <div class="phone-input-container flex gap-2.5 max-[480px]:flex-col">
                                <input type="email" id="email" name="email" placeholder="e.g. bhavesh@example.com" value="<%= adminDB ? adminDB.email : '' %>" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)] flex-1">
                                <button type="button" class="btn-get-otp bg-[#333] text-white py-0 px-5 border-none rounded-lg text-[0.85rem] font-bold cursor-pointer transition-colors duration-300 whitespace-nowrap hover:bg-[#111] max-[480px]:w-full max-[480px]:py-3" id="sendOtpBtn">Send OTP</button>
                            </div>
                            <small id="otpStatusMsg" class="mt-[5px] text-[0.85rem] font-bold"></small>
                        </div>
                    </div>

                    <div class="input-group flex flex-col gap-2 mb-2.5 mt-[15px]">
                        <label for="otpCode" class="font-bold text-[0.85rem] text-[#444] uppercase tracking-[0.5px]">Enter OTP</label>
                        <input type="text" id="otpCode" name="otp" placeholder="• • • • • •" maxlength="6" required class="w-full p-3.5 border border-[#ddd] rounded-lg text-base text-[#333] bg-[#fafafa] font-sans transition-all duration-300 focus:outline-none focus:border-[#ff9800] focus:bg-white focus:shadow-[0_0_0_3px_rgba(255,152,0,0.15)] tracking-[5px] font-bold text-center max-w-[200px]">
                    </div>
                </div>

                <button type="submit" class="btn-submit bg-[#ff9800] text-white p-4 border-none rounded-lg text-base font-bold cursor-pointer transition-all duration-300 flex justify-center items-center gap-2.5 w-full hover:bg-[#e68a00] hover:-translate-y-[2px] hover:shadow-[0_8px_20px_rgba(255,152,0,0.3)] mt-6">
                    <i class="fa-solid fa-check-circle"></i> Verify & Save Profile
                </button>
                
                <% if (admin && admin.isAdmin) { %>
                    </div> <!-- End of editProfileContainer -->
                <% } %>
                
            </form>

            <% if (!admin || !admin.isAdmin) { %>
            <!-- Login Switch Section -->
            <div class="text-center mt-7 pt-6 border-t border-[#eee]">
                <p class="text-[#555] text-[0.95rem] m-0">
                    Already registered? 
                    <a href="/admin/login" class="text-[#ff9800] font-bold no-underline ml-[5px] hover:underline">
                        Login here <i class="fa-solid fa-arrow-right-to-bracket ml-[3px]"></i>
                    </a>
                </p>
            </div>
            <% } %>

        </div>
        
        <!-- Message Box -->
        <section id="message" class="skill-message fixed top-6 left-1/2 -translate-x-1/2 w-[min(92vw,420px)] rounded-xl opacity-0 -translate-y-3 z-[9999999] transition-all duration-300 pointer-events-none" aria-live="polite"></section>
    </main>

    <%- include("./partials/footer") %>
    
    <!-- Client-side Password Match Validation -->
    <script>
        const form = document.getElementById('adminFormId');
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirmPassword');
        const msg = document.getElementById('message');

        if(form) {
            form.addEventListener('submit', function(e) {
                if(pass.value !== confirmPass.value) {
                    e.preventDefault(); // Form submit hone se rok dega
                    msg.style.color = "red";
                    msg.innerText = "Passwords do not match!";
                    confirmPass.focus();
                }
            });
        }
        // OTP Send AJAX Logic
        const sendOtpBtn = document.getElementById('sendOtpBtn');
        const emailInput = document.getElementById('email');
        const otpStatusMsg = document.getElementById('otpStatusMsg');

        if (sendOtpBtn) {
            sendOtpBtn.addEventListener('click', async () => {
                const email = emailInput.value.trim();
                if (!email) {
                    otpStatusMsg.style.color = "red";
                    otpStatusMsg.innerText = "Pehle email enter karein!";
                    return;
                }

                sendOtpBtn.disabled = true;
                sendOtpBtn.innerText = "Sending...";
                otpStatusMsg.innerText = "OTP bhej raha hai...";
                otpStatusMsg.style.color = "#ff9800";

                try {
                    const res = await fetch('/admin/sendOtp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email })
                    });
                    const data = await res.json();

                    if (res.ok) {
                        otpStatusMsg.style.color = "green";
                        otpStatusMsg.innerText = data.message;
                        sendOtpBtn.innerText = "Sent \u2713";
                    } else {
                        otpStatusMsg.style.color = "red";
                        otpStatusMsg.innerText = data.message;
                        sendOtpBtn.disabled = false;
                        sendOtpBtn.innerText = "Send OTP";
                    }
                } catch (error) {
                    otpStatusMsg.style.color = "red";
                    otpStatusMsg.innerText = "Network Error! Server se connect nahi ho paya.";
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.innerText = "Send OTP";
                }
            });
        }
    </script>
</body>
</html>